---
import type { Project } from '../../lib/projects';
import { getProjectUrl } from '../../lib/projects';
import StatusPill from './StatusPill.astro';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const url = getProjectUrl(project);
---

<article class="group border-t border-surface1 py-6 first:border-t-0">
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
    <h3 class="text-xl font-bold">
      <a href={url} class="text-text group-hover:text-blue transition-colors">
        {project.data.name}
      </a>
    </h3>
    <StatusPill status={project.data.status} />
  </div>

  <p class="mt-2 text-subtext0">{project.data.tagline}</p>

  {project.data.tech && project.data.tech.length > 0 && (
    <p class="mt-3 text-sm text-overlay2">{project.data.tech.join(' · ')}</p>
  )}
</article>
