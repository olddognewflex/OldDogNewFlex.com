---
import type { ProjectStatus } from '../../lib/projects';
import { STATUS_LABELS } from '../../lib/projects';

export interface Props {
  status: ProjectStatus;
  class?: string;
}

const { status, class: className = '' } = Astro.props;

// Active work reads warm, finished work reads calm, stalled work recedes.
const statusClasses: Record<ProjectStatus, string> = {
  building: 'border-peach/60 text-peach',
  exploring: 'border-sky/60 text-sky',
  shipped: 'border-teal/60 text-teal',
  paused: 'border-overlay1 text-overlay2',
  archived: 'border-surface2 text-overlay1',
};
---

<span
  class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium uppercase tracking-wide ${statusClasses[status]} ${className}`}
>
  {STATUS_LABELS[status]}
</span>
