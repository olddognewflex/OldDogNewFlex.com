---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import ProjectRow from '../components/projects/ProjectRow.astro';
import WritingRow from '../components/writing/WritingRow.astro';
import { getRecentWriting } from '../lib/blog';
import { getAllProjects, getFeaturedProjects, getProjectUrl } from '../lib/projects';

const [featuredProjects, allProjects, recentWriting] = await Promise.all([
  getFeaturedProjects(3),
  getAllProjects(),
  getRecentWriting(5),
]);

// Derived, not duplicated — the "currently building" line stays true on its own
// because it reads the same project entries /projects does.
const building = allProjects.filter(
  (project) => project.data.status === 'building' && project.data.kind !== 'practice',
);
---

<BaseLayout 
  title="Old Dog, New Flex | Home" 
  description="Almost 30 years building software, still learning. What I'm building, learning, and thinking about — projects, notes, and writing from an engineer who keeps reinventing himself."
  heroImage="/images/odnf-home-hero.webp" 
  heroAlt="An elderly man with a long white beard and flowing hair, wearing bright, retro-futuristic clothes including an orange and pink jacket, neon sunglasses, and large headphones, sitting confidently at a modern computer keyboard. The scene is colorful, vibrant, and filled with 80s-inspired nostalgia. The background is a cozy, cluttered room with toys and gadgets. The style is cinematic, realistic, and expressive, with dramatic lighting and detailed textures."
  heroTagline="Proving it's never too late to refactor your comfort zone">

  <!-- Identity: who this is, in a few seconds -->
  <section class="pt-16 pb-12">
    <Container size="md">
      <h1 class="text-5xl font-bold text-blue mb-4">Old Dog, New Flex</h1>
      <h2 class="text-3xl font-bold text-blue mb-6">Experience isn't a liability. It's leverage.</h2>
      <p class="text-xl text-text">
        I've been building software for almost 30 years — through multiple hype cycles,
        architectural shifts, and "this changes everything" moments that... didn't.
      </p>
      <p class="mt-5 text-xl text-text">
        I'm still learning. Apparently I haven't learned my lesson.
      </p>
      <p class="mt-5 text-xl text-text">
        This is my corner of the internet: what I'm building, what I'm learning, and what
        I'm still arguing with myself about. The site is the record. The writing is the
        commentary.
      </p>
    </Container>
  </section>

  <!-- Currently -->
  {building.length > 0 && (
    <section class="py-10 border-t border-surface1">
      <Container size="md">
        <h2 class="text-sm font-bold uppercase tracking-wide text-subtext0 mb-4">Currently</h2>
        <p class="text-xl text-text">
          <span class="text-subtext0">Building</span>{' '}
          {building.map((project, i) => (
            <>
              {i > 0 && <span class="text-overlay2"> · </span>}
              <a href={getProjectUrl(project)} class="text-mauve hover:text-blue transition-colors">
                {project.data.name}
              </a>
            </>
          ))}
        </p>
        <p class="mt-4">
          <a href="/now" class="text-mauve hover:text-blue transition-colors">
            What else I'm up to right now →
          </a>
        </p>
      </Container>
    </section>
  )}

  <!-- Projects -->
  {featuredProjects.length > 0 && (
    <section class="py-10 border-t border-surface1">
      <Container size="md">
        <h2 class="text-sm font-bold uppercase tracking-wide text-subtext0 mb-6">Projects</h2>
        <div>
          {featuredProjects.map((project) => (
            <ProjectRow project={project} />
          ))}
        </div>
        <p class="mt-8">
          <a href="/projects" class="text-mauve hover:text-blue transition-colors">
            All projects →
          </a>
        </p>
      </Container>
    </section>
  )}

  <!-- Recent writing -->
  <section class="py-10 border-t border-surface1">
    <Container size="md">
      <h2 class="text-sm font-bold uppercase tracking-wide text-subtext0 mb-6">Recent writing</h2>
      <div>
        {recentWriting.map((item) => (
          <WritingRow
            url={item.url}
            title={item.title}
            date={item.date}
            label={item.label}
            summary={item.summary}
          />
        ))}
      </div>
      <p class="mt-8">
        <a href="/writing" class="text-mauve hover:text-blue transition-colors">
          All writing →
        </a>
      </p>
    </Container>
  </section>

  <!-- Positioning: kept from the previous homepage, it still says the thing -->
  <section class="py-10 border-y border-surface1">
    <Container size="sm">
      <p class="text-xl text-center">
        No hype. No predictions. Just durable thinking from someone who's seen a few
        things break.<br />
        A long-game project for people who care about <strong>durability over novelty</strong>.
      </p>
    </Container>
  </section>

  <!-- Elsewhere -->
  <section class="py-14">
    <Container size="md">
      <h2 class="text-sm font-bold uppercase tracking-wide text-subtext0 mb-6">Elsewhere</h2>
      <div class="flex flex-wrap gap-x-8 gap-y-3">
        <a href="https://github.com/olddognewflex" target="_blank" rel="noopener noreferrer" class="text-mauve hover:text-blue transition-colors">
          GitHub →
        </a>
        <a href="https://techhub.social/@olddognewflex" target="_blank" rel="noopener noreferrer" class="text-mauve hover:text-blue transition-colors">
          Mastodon →
        </a>
        <a href="https://x.com/OldDogNewFlex" target="_blank" rel="noopener noreferrer" class="text-mauve hover:text-blue transition-colors">
          X →
        </a>
        <a href="/rss.xml" class="text-mauve hover:text-blue transition-colors">
          RSS →
        </a>
        <a href="/contact" class="text-mauve hover:text-blue transition-colors">
          Email →
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
